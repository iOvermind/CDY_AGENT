#!/usr/bin/env bash
# ttyd 進來的第一層：輸入工號。
#
#   AGENT_USERS   一般工號，逗號分隔。輸入後直接進該工號的 tmux 選單。
#   AGENT_ADMINS  admin 工號，逗號分隔。輸入後還要密碼（比對 AGENT_ADMIN_PASSWORD_HASH），
#                 通過後進 admin 選單：看得到所有工號的 session，預設目錄是 AGENT_ADMIN_HOME。
#
# 工號不分大小寫。選單裡選「換工號」會回到這裡。
#
# 這是「軟區分」：防止大家搶同一個畫面、防止一般同仁隨手進 admin，不是權限控管——
# 所有人在容器裡都是同一個 Linux 帳號 dev。真正的門在 Cloudflare Access。
set -uo pipefail

declare -A users=() admins=()

load_ids() { # load_ids <陣列名稱> <逗號分隔字串>
  local -n dest="$1"
  local raw u
  local -a list
  IFS=',' read -r -a list <<< "$2"
  for raw in "${list[@]}"; do
    u="$(printf '%s' "$raw" | tr -d '[:space:]')"
    [[ "$u" =~ ^[A-Za-z0-9_-]+$ ]] || continue
    dest["${u^^}"]="$u"
  done
}
# AGENT_ROLE=user 只收一般工號、admin 只收 admin 工號、未設定兩種都收（見 agent-entrypoint）。
case "${AGENT_ROLE:-}" in
  user)  load_ids users "${AGENT_USERS:-}" ;;
  admin) load_ids admins "${AGENT_ADMINS:-}" ;;
  *)     load_ids users "${AGENT_USERS:-}"; load_ids admins "${AGENT_ADMINS:-}" ;;
esac

# AGENT_ADMIN_PASSWORD_HASH 接受兩種寫法：
#   1. 原樣的 $6$<salt>$<hash>（`openssl passwd -6` 的輸出）
#   2. 上面那串再 base64（`openssl passwd -6 | base64 -w0`）——完全沒有 $，放進 Dockhand
#      的環境變數、.env、compose 都不會被當成變數展開，最不容易出錯。
# 也容忍外面多包一層引號、或 compose 跳脫用的 $$。
admin_hash() {
  local h="${AGENT_ADMIN_PASSWORD_HASH:-}"
  h="${h#\'}"; h="${h%\'}"; h="${h#\"}"; h="${h%\"}"
  h="${h//\$\$/\$}"
  if [[ "$h" != '$6$'* ]]; then
    h="$(printf '%s' "$h" | base64 -d 2>/dev/null | tr -d '\n')" || h=''
  fi
  printf '%s' "$h"
}

# 比對 SHA-512 crypt 雜湊。
verify_password() {
  local hash salt got
  hash="$(admin_hash)"
  [[ "$hash" == '$6$'*'$'* ]] || return 1
  salt="${hash#\$6\$}"
  salt="${salt%%\$*}"
  got="$(printf '%s' "$1" | openssl passwd -6 -salt "$salt" -stdin 2>/dev/null)" || return 1
  [ "$got" = "$hash" ]
}

# 回傳 0 表示通過。錯 3 次鎖 30 秒後回到輸入工號。
admin_auth() {
  if [ -z "${AGENT_ADMIN_PASSWORD_HASH:-}" ]; then
    printf '\033[31m尚未設定 admin 密碼（AGENT_ADMIN_PASSWORD_HASH），admin 無法登入。\033[0m\n'
    sleep 3
    return 1
  fi
  local tries pw
  for tries in 1 2 3; do
    read -r -s -p '請輸入 admin 密碼：' pw || return 1
    echo
    if verify_password "$pw"; then
      return 0
    fi
    printf '\033[33m密碼錯誤（%d/3）。\033[0m\n' "$tries"
    sleep 1
  done
  printf '\033[31m錯誤太多次，鎖定 30 秒。\033[0m\n'
  sleep 30
  return 1
}

# Ctrl+C 只清掉這一行輸入，不要讓 ttyd 整個斷線。
trap 'echo' INT

fails=0
while true; do
  printf '\033[2J\033[H'
  if [ "${AGENT_ROLE:-}" = admin ]; then
    printf '\033[35m══ CDY_AGENT admin ══\033[0m\n\n'
  else
    printf '\033[36m══ CDY_AGENT ══\033[0m\n\n'
  fi
  if [ "${#users[@]}" -eq 0 ] && [ "${#admins[@]}" -eq 0 ]; then
    printf '\033[31m尚未設定任何工號（AGENT_USERS 是空的），請聯絡管理者。\033[0m\n'
    sleep 30
    continue
  fi

  read -r -p '請輸入工號：' input || { sleep 1; continue; }
  key="$(printf '%s' "$input" | tr -d '[:space:]')"
  key="${key^^}"

  if [ -n "$key" ] && [ -n "${admins[$key]:-}" ]; then
    if admin_auth; then
      fails=0
      /usr/local/bin/agent-selector --admin "${admins[$key]}"
    fi
    continue
  fi

  if [ -n "$key" ] && [ -n "${users[$key]:-}" ]; then
    fails=0
    /usr/local/bin/agent-selector "${users[$key]}"
    continue
  fi

  fails=$((fails + 1))
  printf '\033[33m查無此工號。\033[0m\n'
  # 連錯幾次就稍微拖慢，避免被拿來亂猜。
  if [ "$fails" -ge 3 ]; then sleep 5; else sleep 1; fi
done
